# Copy to .env and fill in real values. Never commit the populated .env file.

# PostGIS connection string used by the ETL pipeline and the Airflow DAG.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Project paths. Defaults assume the repo lives at $HOME/geospatial-capstone.
CAPSTONE_PROJECT_DIR=/path/to/geospatial-capstone
CAPSTONE_INPUT_FILE=/path/to/geospatial-capstone/input/addresses_sample.csv
CAPSTONE_OUTPUT_DIR=/path/to/geospatial-capstone/output
CAPSTONE_REJECTED_DIR=/path/to/geospatial-capstone/rejected
CAPSTONE_ALERTS_DIR=/path/to/geospatial-capstone/alerts
CAPSTONE_LOGS_DIR=/path/to/geospatial-capstone/logs

# Airflow home directory.
AIRFLOW_HOME=/path/to/airflow
